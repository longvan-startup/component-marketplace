      "compositePrimaryKeys": {},
      "uniqueConstraints": {},
      "policies": {},
      "checkConstraints": {
        "components_slug_format_check": {
          "name": "components_slug_format_check",
          "value": "\"components\".\"slug\" ~ '^[a-z0-9]+(-[a-z0-9]+)*$' AND char_length(\"components\".\"slug\") <= 80"
        },
        "components_name_length_check": {
          "name": "components_name_length_check",
          "value": "char_length(\"components\".\"name\") BETWEEN 1 AND 120"
        },
        "components_description_length_check": {
          "name": "components_description_length_check",
          "value": "\"components\".\"description\" IS NULL OR char_length(\"components\".\"description\") <= 5000"
        },
        "components_tags_count_check": {
          "name": "components_tags_count_check",
          "value": "cardinality(\"components\".\"tags\") <= 12 AND coalesce(array_ndims(\"components\".\"tags\"), 0) <= 1 AND array_position(\"components\".\"tags\", '') IS NULL AND array_position(\"components\".\"tags\", NULL) IS NULL"
        },
        "components_latest_version_check": {
          "name": "components_latest_version_check",
          "value": "\"components\".\"latest_version\" ~ '^[0-9]+\\.[0-9]+\\.[0-9]+$'"
        },
        "components_price_amount_check": {
          "name": "components_price_amount_check",
          "value": "\"components\".\"price_amount_minor\" IS NULL OR \"components\".\"price_amount_minor\" > 0"
        },
        "components_price_currency_check": {
          "name": "components_price_currency_check",
          "value": "\"components\".\"price_currency\" IS NULL OR \"components\".\"price_currency\" ~ '^[A-Z]{3}$'"
        },
        "components_price_pair_check": {
          "name": "components_price_pair_check",
          "value": "(\"components\".\"price_amount_minor\" IS NULL) = (\"components\".\"price_currency\" IS NULL)"
        },
        "components_paid_update_price_check": {
          "name": "components_paid_update_price_check",
          "value": "NOT \"components\".\"requires_payment_for_update\" OR \"components\".\"price_amount_minor\" IS NOT NULL"
        }
      },
      "isRLSEnabled": false
