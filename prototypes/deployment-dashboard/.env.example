# Supply secrets through the hosting environment, never commit their values.
DASHBOARD_ORIGIN=http://localhost:3400
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Immutable GitHub user IDs for Long and Văn; update only when access changes.
DASHBOARD_GITHUB_IDS=199343172,92101206
# Only project IDs listed here are exposed to authorized dashboard users.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_IDS=

# Release status and workflow dispatch. The app token is server-side and should
# be installed only on this repository with Actions read/write + Contents read.
RELEASE_GITHUB_REPOSITORY=longvan-startup/component-marketplace
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=

# The Web and API cards point to the same Vercel project and release.
RELEASE_VERCEL_PROJECT_ID=
PRODUCTION_WEB_URL=
PRODUCTION_API_URL=

# Keep false until GitHub production environment protection, workflow secrets,
# Vercel staged deployment settings, and production URLs have been verified.
RELEASE_PRODUCTION_ENABLED=false
