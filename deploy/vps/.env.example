# deploy/vps/.env.example — real values go to /opt/cmp-api/.env ON THE VPS
# (never committed). chmod 600.

# Neon connection string (Settings → Connection Details, pooled endpoint).
DATABASE_URL=

# PAT with read:packages scope, used only to pull the api image from ghcr.io.
GHCR_TOKEN=

# Optional overrides:
# API_BIND=127.0.0.1
# API_PORT=4000
