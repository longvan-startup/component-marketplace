# =============================================================
# Component Marketplace — Environment variables (SAMPLE ONLY)
# Copy thành .env và điền giá trị thật. KHÔNG commit .env.
# =============================================================

# --- General ---
NODE_ENV=development

# --- Web (Next.js on Vercel / container) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- API (Bun + Express) ---
API_PORT=4000
PORT=4000
# CORS allowlist cho dev cross-origin (browser :3000 → api :4000).
# CSV exact-match, ví dụ: CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Production same-origin qua Vercel Services (/api/*) KHÔNG cần biến này.
# CORS_ORIGINS=

# --- Database (host-side: migrate, IDE, tooling) ---
# Trỏ tới postgres compose qua port host 5433 (compose map host 5433 -> container 5432).
# Container API KHÔNG dùng biến này — compose tự dựng URL nội bộ qua
# POSTGRES_* (xem compose.yaml).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/component_marketplace

# --- Compose PostgreSQL (chỉ dùng local) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=component_marketplace
# Host port mặc định 5433 để tránh conflict với Postgres khác trên máy
POSTGRES_PORT=5433

# --- Auth: Better Auth ---
# Generate a new secret with: bunx --bun auth@1.7.14 secret
BETTER_AUTH_SECRET=
# Public API base URL (for local web :3000 -> API :4000).
BETTER_AUTH_URL=http://localhost:4000

# --- Payment: Lemon Squeezy (tích hợp sau) ---
# LEMON_SQUEEZY_API_KEY=
# LEMON_SQUEEZY_STORE_ID=

# --- Storage: Cloudflare R2 (tích hợp sau) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
