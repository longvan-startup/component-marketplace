# =============================================================
# Component Marketplace — Environment variables (SAMPLE ONLY)
# Copy thành .env và điền giá trị thật. KHÔNG commit .env.
# =============================================================

# --- General ---
NODE_ENV=development

# --- Web (Next.js on Vercel / container) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- API (Bun + Express) ---
API_PORT=4000
PORT=4000

# --- Database (PostgreSQL local / Neon) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/component_marketplace

# --- Compose PostgreSQL (chỉ dùng local) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=component_marketplace
# Host port mặc định 5433 để tránh conflict với Postgres khác trên máy
POSTGRES_PORT=5433

# --- Auth: Better Auth (tích hợp sau) ---
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=

# --- Payment: Lemon Squeezy (tích hợp sau) ---
# LEMON_SQUEEZY_API_KEY=
# LEMON_SQUEEZY_STORE_ID=

# --- Storage: Cloudflare R2 (tích hợp sau) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
